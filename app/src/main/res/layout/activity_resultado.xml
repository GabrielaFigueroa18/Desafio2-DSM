<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorGeneral5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/textoTipoQuiz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quiz: Matemáticas"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/colorGeneralTexto"
            android:gravity="center"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/textoDificultad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dificultad: Fácil"
            android:textSize="15sp"
            android:textColor="@color/colorTextoSecundario"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/colorGeneral1"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/colorGeneral4">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Resultado"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorGeneralTexto"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/textoPuntaje"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Obtuviste 4 de 5 respuestas correctas."
                    android:textSize="16sp"
                    android:textColor="@color/colorTextoPrincipal"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/textoRetroalimentacion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¡Muy bien!"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorGeneral1" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Revisión de respuestas"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextoPrincipal"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/contenedorRevision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonReintentar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Reintentar Quiz"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/colorGeneralTextoOnPrimary"
            app:backgroundTint="@color/colorGeneral1"
            app:cornerRadius="12dp"
            android:textAllCaps="false"
            android:layout_marginBottom="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonOtroQuiz"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Elegir otro Quiz"
            android:textSize="15sp"
            android:textColor="@color/colorGeneralTexto"
            app:strokeColor="@color/colorGeneral1"
            app:cornerRadius="12dp"
            android:textAllCaps="false"
            android:layout_marginBottom="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonInicio"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Volver al inicio"
            android:textSize="15sp"
            android:textColor="@color/colorTextoSecundario"
            android:textAllCaps="false"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tituloResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Resultado del Quiz"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/textoTipoQuiz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quiz: Cultura General"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/textoDificultad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dificultad: Fácil"
            android:textSize="17sp"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/textoPuntaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Obtuviste 4 de 5 respuestas correctas."
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/textoRetroalimentacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Me merezco un churro."
            android:textSize="19sp"
            android:gravity="center"
            android:layout_marginBottom="30dp" />

        <TextView
            android:id="@+id/tituloRevision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Revisión de respuestas"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="15dp" />

        <LinearLayout
            android:id="@+id/contenedorRevision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/botonReintentar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Volver a intentar"
            android:textSize="16sp"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/botonOtroQuiz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Elegir otro quiz"
            android:textSize="16sp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/botonInicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Volver al inicio"
            android:textSize="16sp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>

</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorCultura5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quiz de Cultura General"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/colorCulturaTexto"
            android:gravity="center"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/textoDificultad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dificultad: Fácil"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/colorCultura1"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/colorCultura1"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/colorCultura4">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="Pon a prueba tus conocimientos sobre diferentes temas del mundo."
                android:textSize="14sp"
                android:textColor="@color/colorCulturaTexto"
                android:gravity="center"
                android:lineSpacingExtra="3dp" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/contenedorPreguntas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonEnviar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Enviar Quiz"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/colorBlanco"
            app:backgroundTint="@color/colorCultura1"
            app:cornerRadius="12dp"
            android:textAllCaps="false"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonReiniciar"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Reiniciar"
            android:textSize="15sp"
            android:textColor="@color/colorCulturaTexto"
            app:strokeColor="@color/colorCultura1"
            app:cornerRadius="12dp"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>